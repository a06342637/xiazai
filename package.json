    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "playwright": "^1.56.1"
  },
  "overrides": { "minimatch": "^11.0.5" }
}
