{
  "name": "xiazai",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "description": "Self-hosted temporary file sharing with Docker and online updates",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
