# 安装脚本会提示输入账号密码。手动部署请修改密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-random-password
UPDATE_KEY=replace-with-a-different-random-update-key-at-least-24-characters
PORT=8080
DATA_DIR=/root/xiazai
APP_IMAGE=ghcr.io/a06342637/xiazai:1.0.1
UPDATER_IMAGE=ghcr.io/a06342637/xiazai:1.0.1
# 配置 HTTPS 域名后可填 https://files.example.com；留空时浏览器使用当前域名。
PUBLIC_URL=
